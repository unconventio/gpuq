# App-menu launcher for the gpuq live view: copy to ~/.local/share/applications/.
# Started this way gpuq is the window's own program, so closing the window doesn't ask
# "close with a running program?". For a bigger window, set Terminal=false and launch the
# terminal yourself, e.g.  Exec=gnome-terminal --geometry=130x40 -- gpuq  (README: launcher).
[Desktop Entry]
Type=Application
Name=GPU Queue
Comment=Live view of the GPU queue on every machine
Exec=gpuq
Terminal=true
Icon=utilities-system-monitor
Categories=System;Monitor;ConsoleOnly;
Keywords=gpu;queue;nvidia;rocm;
